{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs2022",
      "displayName": "Windows x64 - Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-vs2022",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/../1.1.1/sdk",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../my_project/downloads/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../my_project/vcpkg_installed",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "OpenCV_DIR": "${sourceDir}/../my_project/vcpkg_installed/x64-windows/share/opencv4"
      }
    },
    {
      "name": "clangd",
      "displayName": "clangd compilation database",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clangd",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "${sourceDir}/../1.1.1/sdk",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../my_project/downloads/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../my_project/vcpkg_installed",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "OpenCV_DIR": "${sourceDir}/../my_project/vcpkg_installed/x64-windows/share/opencv4"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-vs2022",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-vs2022",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
